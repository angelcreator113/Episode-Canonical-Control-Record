{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run validate)",
      "Bash(npm run lint)",
      "Bash(npm run validate:*)",
      "Bash(node scripts/validate-routes.js)",
      "Bash(bash scripts/lint-silent-catches.sh)",
      "Bash(bash scripts/audit-cost-exposure.sh)",
      "Bash(node scripts/check-root-junk.js)",
      "Bash(node -c *)",
      "Bash(cd frontend && npx vite build)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-remote *)",
      "Bash(git branch *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * dev)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * dev)",
      "PowerShell(git push --force *)",
      "mcp__github__enable_pr_auto_merge",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./frontend/.env)",
      "Read(./backups/**)",
      "Read(./docs/cognito-ids.txt)",
      "Read(./docs/connect-to-ec2.txt)",
      "Read(./docs/rds-endpoint-dev.txt)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.js"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dangerous-commands.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-github-tools.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
